      "bundleIdentifier": "com.vizehelp.buddy"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4A90D9"
      },
      "package": "com.vizehelp.buddy"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
